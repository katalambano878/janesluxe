# =============================================================================
# Jane's Luxe — environment template (no real secrets)
# Plain Postgres (staging/prod on VPS): set DATABASE_URL + AUTH_JWT_SECRET
# Legacy hosted Supabase: set NEXT_PUBLIC_SUPABASE_* + SUPABASE_SERVICE_ROLE_KEY
# =============================================================================

# --- Plain PostgreSQL (preferred after migration) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/janesluxe
# POSTGRES_URL=  # alternate name; either works
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000
PG_LOCK_TIMEOUT_MS=5000
PG_IDLE_IN_TX_MS=30000
# PGSSL=require
AUTH_JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
NEXT_PUBLIC_USE_PLAIN_PG=true

# Browser client points at this app's /rest/v1 and /auth/v1 shims (own domain)
# or at hosted Supabase during legacy mode:
NEXT_PUBLIC_SUPABASE_URL=https://www.janesluxe.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key
# Only required when NOT using DATABASE_URL:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Payments — Moolre (primary) ---
MOOLRE_API_KEY=YOUR_MOOLRE_API_KEY
MOOLRE_PUBLIC_KEY=YOUR_MOOLRE_PUBLIC_KEY
MOOLRE_ACCOUNT_NUMBER=YOUR_MOOLRE_ACCOUNT_NUMBER
MOOLRE_CALLBACK_SECRET=YOUR_CALLBACK_QUERY_KEY
# Callback URL to register: https://yourdomain.com/api/payment/moolre/callback?key=YOUR_CALLBACK_QUERY_KEY

# --- Payments — Paystack (legacy / optional) ---
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=YOUR_PAYSTACK_PUBLIC_KEY
PAYSTACK_SECRET_KEY=YOUR_PAYSTACK_SECRET_KEY

# --- Email (Resend) ---
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=noreply@yourdomain.com
EMAIL_FROM=JANE'S LUXE <noreply@yourdomain.com>
ADMIN_EMAIL=admin@yourdomain.com

# --- SMS (Moolre) ---
MOOLRE_SMS_API_KEY=YOUR_MOOLRE_SMS_API_KEY
SMS_SENDER_ID=JANESLUXE

# --- App identity ---
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_NAME=Jane's Luxe
NEXT_PUBLIC_SITE_DESCRIPTION=Luxury fashion and accessories
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
NEXT_PUBLIC_CONTACT_PHONE=YOUR_PHONE_NUMBER
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=YOUR_PHONE_NUMBER
NEXT_PUBLIC_SOCIAL_INSTAGRAM=@YOUR_HANDLE
NEXT_PUBLIC_WHATSAPP_URL=YOUR_WHATSAPP_URL
NEXT_PUBLIC_WHATSAPP_GROUP_URL=YOUR_WHATSAPP_GROUP_URL

# --- Security ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY
RECAPTCHA_SECRET_KEY=YOUR_RECAPTCHA_SECRET_KEY

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=YOUR_GA4_MEASUREMENT_ID
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=YOUR_GOOGLE_VERIFICATION_CODE

# --- AI chat (optional) ---
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# --- Cron / maintenance ---
CRON_SECRET=YOUR_CRON_SECRET
MAINTENANCE_MODE=false

# --- Admin bootstrap (scripts/create-admin.mjs) ---
ADMIN_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD
